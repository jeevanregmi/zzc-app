rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }
    function isCreatingAsOwner() {
      return isSignedIn() && request.auth.uid == request.resource.data.ownerId;
    }
    // Prevents ownerId field from being changed after creation
    function ownerUnchanged() {
      return !("ownerId" in request.resource.data)
          || request.resource.data.ownerId == resource.data.ownerId;
    }
    // DEV bypass — allows unauthenticated access to dev-seeded pipeline data.
    // This UID never appears in production; removing it has zero prod impact.
    function isDevOwner(ownerId) {
      return ownerId == "dev-zzc-pipeline-2026";
    }

    // ── PUBLIC: read-only static data ────────────────────────────────────────
    match /structuredSchemes/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /market_rates/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── VAULT: media metadata ────────────────────────────────────────────────
    match /vault_media/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── VAULT: folder hierarchy ──────────────────────────────────────────────
    match /vault_folders/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── VAULT: document intelligence ────────────────────────────────────────
    match /vault_documents/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── VAULT: AI generation queue ───────────────────────────────────────────
    match /vault_ai_queue/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── BUSINESS INTELLIGENCE: all collections ───────────────────────────────
    match /business_revenue/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_expenses/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_ai_costs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_youtube/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_playstore/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_analytics/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_content/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_affiliates/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_goals/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /business_subscriptions/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── EVENT BUS: append-only audit log ────────────────────────────────────
    match /domain_events/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      // No update or delete — events are immutable once written
      allow update, delete: if false;
    }

    // ── AUDIENCE: leads + recommendation signals ─────────────────────────────
    match /audience_leads/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /recommendation_signals/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: founder briefings + generation logs ────────────────────
    match /founder_intelligence/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;              // briefings are read-only after creation
    }
    match /ai_generation_logs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;              // generation logs are immutable (audit trail)
    }

    // ── CONTENT: assets + topics ─────────────────────────────────────────────
    match /business_content_assets/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /financial_topics/{docId} {
      allow read:   if true;               // topics are semi-public reference data
      allow write:  if isSignedIn() && request.auth.uid != null;
    }

    // ── INTELLIGENCE: intelligence docs (AI-processed source material) ────────
    match /vault_intelligence_docs/{docId} {
      // Approved docs are publicly readable (for /janta public page)
      allow read:   if resource.data.adminApprovalStatus == "approved"
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: content queue (AI-generated drafts awaiting approval) ──
    match /vault_content_queue/{docId} {
      // publishToJanta=true items are publicly readable on /janta
      allow read:   if resource.data.publishToJanta == true
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: source signals (extracted intelligence signals) ─────────
    match /source_signals/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: monitored sources (RSS/URL monitoring config) ───────────
    match /monitored_sources/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: source updates (detected new docs from monitored sources) ─
    match /source_updates/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: topics (taxonomy — semi-public reference data) ──────────
    match /intelligence_topics/{docId} {
      allow read:  if true;
      allow write: if isSignedIn() && request.auth.uid != null;
    }

    // ── INTELLIGENCE: signal routes (system config — vault owner manages) ───────
    match /signal_routes/{docId} {
      allow read:  if isSignedIn() || request.auth == null; // routing config is readable by dev mode
      allow write: if isSignedIn();                          // any authenticated session can manage routes
    }

    // ── INTELLIGENCE: market rate suggestions (pipeline output) ───────────────
    match /market_rate_suggestions/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── INTELLIGENCE: scheme suggestions (pipeline output) ────────────────────
    match /scheme_suggestions/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: civic term dictionary (Constitution, policy glossary) ─────────
    match /civic_terms/{docId} {
      // All published terms are publicly readable — this is the foundational
      // dictionary for ZZC Janta public intelligence
      allow read:   if resource.data.publishToJanta == true
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: civic promises (accountability layer — promise vs reality) ───────
    match /policy_promises/{docId} {
      // Published promises are publicly readable — core of the accountability layer
      allow read:   if resource.data.publishToJanta == true
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: per-point gaming cards (extracted from intelligence docs) ──────
    match /vault_policy_points/{docId} {
      // Published points are publicly readable on /janta
      allow read:   if resource.data.publishToJanta == true
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: deep intelligence records (all structured civic data) ─────────
    match /janta_intelligence/{docId} {
      // publishToJanta=true: publicly readable on /janta
      // domain==finance: NRB/banking docs are public circulars, readable on /finance
      allow read:   if resource.data.publishToJanta == true
                    || resource.data.domain == "finance"
                    || isOwner(resource.data.ownerId)
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: knowledge graph edges — relationships between intel records ────
    match /janta_relationships/{docId} {
      // Relationships are owner-readable only (no public read — internal graph)
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: document registry (source document metadata for the graph) ─────
    match /janta_documents/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: entities — ministries, officials, projects (canonical nodes) ───
    match /janta_entities/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── JANTA: progress updates (implementation evidence attached to records) ──
    match /janta_progress/{docId} {
      allow read:   if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── CONSTITUTION: root ontology of the governance intelligence graph ────────
    match /constitutional_framework/{docId} {
      // All published articles are publicly readable — this is the foundational
      // semantic backbone of ZZC's civic intelligence.
      // Signed-in vault users can read ALL records regardless of publishToJanta.
      allow read:   if isSignedIn()
                    || resource.data.publishToJanta == true
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── CONSTITUTION: constitutional atoms (parsed article-level semantic units) ─
    match /constitutional_atoms/{docId} {
      allow read:   if isSignedIn()
                    || resource.data.publishToJanta == true
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── CONSTITUTION: cross-article relationships (dependency graph edges) ──────
    match /constitutional_relationships/{docId} {
      allow read:   if isSignedIn() || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── CIVIC: atomic intelligence units extracted from approved documents ───────
    match /vault_civic_atoms/{docId} {
      // Signed-in vault admins can read all atoms. Public can read approved atoms.
      allow read:   if isSignedIn()
                    || resource.data.approved == true
                    || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── CIVIC: signals feed (news, RSS, civic monitoring) ─────────────────────
    match /civic_signals/{docId} {
      allow read:   if isSignedIn() || isDevOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner() || isDevOwner(request.resource.data.ownerId);
      allow update: if (isOwner(resource.data.ownerId) && ownerUnchanged()) || isDevOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId) || isDevOwner(resource.data.ownerId);
    }

    // ── FOUNDER VISION VAULT: institutional memory, ideas, letters ───────────────
    match /founder_vision/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── PRODUCTS: ZZC product catalog (constitution tree, future trees) ─────────
    match /zzc_products/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── MEDIA: expression layer atoms (script/prompt/caption wrappers) ────────
    // media_atoms reference constitutional_framework / janta_intelligence records.
    // They never store intelligence — only publication metadata.
    match /media_atoms/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── BHAKTI CHAUTARI: public spiritual expression layer (Phase 5+) ──────────
    // bhakti_atoms are the published expression layer for ZZ Bhakti Chautari.
    // Architectural role: same as media_atoms for the civic world.
    // Created deliberately by founder from reviewed temple_notes/content.
    // Public read only when isPublic==true. Owner manages all writes.
    // Phase 5: open read for isPublic==true items.
    // Until Phase 5, owner-only.
    match /bhakti_atoms/{docId} {
      allow read:   if isOwner(resource.data.ownerId);   // Phase 5: add || resource.data.isPublic == true
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── TEMPLE VAULT: sacred personal sanctuary (owner-only, forever private) ───
    match /temple_notes/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /temple_content/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    // semantic_dictionary: private in Phase 2. Phase 3+ may open read for isPublic==true terms.
    match /semantic_dictionary/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── SACRED TEXT INTAKE (Phase 1 Bhakti pipeline) ────────────────────────
    // sacred_texts: uploaded stotra/bhajan/katha (owner-only, private by default)
    // shloka_atoms: Phase 2 extracted shloka lines (owner-only)
    // Pipeline: sacred_texts → shloka_atoms → spiritual_characters → bhakti_atoms
    match /sacred_texts/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /shloka_atoms/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── SPIRITUAL RECOMMENDATION QUEUE ──────────────────────────────────────
    // AI suggestions pending founder review. Created by analyze-sacred-text API.
    // Updated by founder (approve/edit/reject/defer) from the queue UI.
    match /spiritual_suggestions/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── LIVING SPIRITUAL INTELLIGENCE GRAPH (Phase 2) ───────────────────────
    // spiritual_characters: Layer 2 intelligence nodes (SpiritualCharacter records).
    // spiritual_relationships: leela graph edges.
    // Both are owner-only, forever private (same rules as temple_notes).
    match /spiritual_characters/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
    match /spiritual_relationships/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── CANONICAL DOCUMENT IDENTITY REGISTRY ─────────────────────────────────
    // One record per real-world document. Many vault_intelligence_docs instances
    // can point to one canonical. Used for deduplication, version chaining,
    // and lifecycle monitoring. Owner-only, forever private.
    match /canonical_documents/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── UNIVERSAL RECOMMENDATION QUEUE ──────────────────────────────────────
    // Rule-based enrichment suggestions for all ZZC intelligence objects.
    // Created by the recommendation engine. Reviewed (approved/rejected/snoozed)
    // by the founder. Never auto-applied. Owner-only, forever private.
    match /recommendation_queue/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── ATOMIC INTELLIGENCE: immutable extraction audit log ──────────────────
    // One record per atomic extraction run. Never updated, never deleted.
    // Used for cost tracking and history view in the vault.
    match /atomic_extraction_logs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update, delete: if false;  // immutable audit trail
    }

    // ── ATOMIC INTELLIGENCE: background job tracker ───────────────────────
    // One record per background extraction job, keyed by docId.
    // Written by the Cloudflare worker via Firestore REST API (founder ID token).
    // Frontend polls via onSnapshot to show real-time job progress.
    match /atomic_extraction_jobs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;
    }

    // ── ECONOMIC INTELLIGENCE: Nepal's economic memory layer ─────────────────
    // economy_atoms: Published atoms publicly readable for /economy public page.
    match /economy_atoms/{docId} {
      allow read:   if resource.data.publishedToPublic == true
                    || isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // economy_actors: Named economists, experts, institutions — owner-only.
    match /economy_actors/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // economy_extraction_jobs: Background job tracker keyed by docId.
    // Written by Cloudflare worker via Firestore REST (founder ID token).
    match /economy_extraction_jobs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;
    }

    // economy_extraction_logs: Immutable audit trail.
    match /economy_extraction_logs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update, delete: if false;
    }

    // ── PROMISE TRACKER: accountability layer — government promise vs reality ────
    // promise_atoms: publicReady==true items are publicly readable for /civic/promises.
    // Until founder explicitly sets publicReady=true, atoms are vault-private.
    match /promise_atoms/{docId} {
      allow read:   if resource.data.publicReady == true
                    || isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // promise_extraction_jobs: Background job tracker keyed by docId.
    // Written by Cloudflare worker via Firestore REST (founder ID token).
    match /promise_extraction_jobs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;
    }

    // promise_extraction_logs: Immutable audit trail.
    match /promise_extraction_logs/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update, delete: if false;
    }

    // ── ATOM POOL: founder investigation tasks per atom ──────────────────────
    // One record per founder instruction ("compare this with current year", etc.).
    // Created from /vault/knowledge investigation panel.
    // Status: pending → running → completed | failed (processed by future copilot).
    // Delete allowed — founder can remove a misfiled instruction.
    match /knowledge_investigations/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── ATOM POOL: classification suggestions (founder review queue) ─────────
    // One record per atom (deterministic ID: "${collection}_${atomId}_cls").
    // Created by the rule-based classifier during vault scan.
    // Updated by founder (approve/edit/reject/defer) from /vault/knowledge.
    // Never auto-applied — founder approval required before any public routing.
    match /classification_suggestions/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;  // decisions are immutable — defer/reject, not delete
    }

    // ── FOUNDER MANUAL: version history (draft/approved/rejected lifecycle) ────
    // Founder-only. Tracks which version of the Operating Manual is current.
    match /manual_versions/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if false;  // versions are an audit trail — reject/defer, not delete
    }

    // ── SACRED INTELLIGENCE STUDIO ──────────────────────────────────────────────
    // sacred_works: Canonical work registry (Rudrashtakam, Nirvana Shatakam, etc.)
    // One SacredWork links multiple language versions + audio tracks.
    // Owner-only. Phase 5+: add || resource.data.publicReady == true for public read.
    match /sacred_works/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // audio_assets: Audio track registry (stotra recordings, bhajans, kirtan).
    // License-gated: unknown/restricted = private only.
    // Phase 5+: public read when publicReady==true && licenseStatus==public_domain|open_license
    match /audio_assets/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // source_licenses: License/rights tracking records for external sources.
    // Critical for Bhakti Chautari publish gate — must be verified before public.
    // Owner-only (license status is editorial metadata, not public).
    match /source_licenses/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // sacred_alignments: Line-by-line multilingual alignment (Sanskrit ↔ IAST ↔
    // Nepali ↔ Hindi ↔ English ↔ audio timestamp ↔ rasa).
    // Private study layer. Feeds AI Guru explanation engine (Phase 5+).
    match /sacred_alignments/{docId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isCreatingAsOwner();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── Deny all other paths (catch-all) ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
